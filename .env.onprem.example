# On-prem / LAN fixture: local storage, no cloud profile (config only).
# ADR-0064: the DB owner secret (POSTGRES_PASSWORD) and the app secret
# (HA_DB_PASSWORD) must be distinct.
HA_SESSION_KEY=ci-session-key-000000000000000000000000000000000000
HA_REFRESH_KEY=ci-refresh-key-000000000000000000000000000000000000
HA_DATA_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
POSTGRES_PASSWORD=ci-postgres-owner-password
HA_DB_PASSWORD=ci-postgres-app-password
REDIS_PASSWORD=ci-redis-password
FLOWER_PASSWORD=ci-flower-password
IMAGE_TAG=ci
HA_CLOUD_PROFILE=
HA_OBJECT_STORAGE_BACKEND=local
# Web Push (VAPID) — empty placeholders, required in production (config.py
# prod-guard refuses to boot without them when HA_APP_ENV != "development").
# Generate with: npx web-push generate-vapid-keys  (or scripts/setup_env.py).
# Never commit real keys here.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=admin@example.com
