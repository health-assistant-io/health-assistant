FROM node:24-alpine AS build

WORKDIR /app

RUN npm install -g pnpm@11.22.0

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm run build

FROM node:24-alpine AS runtime
# Static serve the built SPA with a tiny hardened server (non-root).
WORKDIR /app
RUN npm install -g serve@14 \
    && addgroup -S ha && adduser -S ha -G ha
COPY --from=build --chown=ha:ha /app/dist /app/dist

USER ha
EXPOSE 3000

CMD ["serve", "-s", "/app/dist", "-l", "3000", "--no-clipboard"]
