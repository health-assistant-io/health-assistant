{
  "schema": 1,
  "contract": "seed-pack",
  "description": "Executable pin for the seed pack contract (ADR 0056 Phase 0). cases[].files maps pack-relative paths to content; the validator hashes them itself. expect: valid | invalid; error: the PackError code an invalid case must produce.",
  "cases": [
    {
      "name": "bundled-catalog-valid",
      "expect": "valid",
      "manifest": {
        "id": "health-core-catalog",
        "schema_version": "1.0",
        "version": "2026.11.0",
        "license": "CC-BY-SA-4.0",
        "scope": "system",
        "priority": 0,
        "description": "Bundled curated catalog (medications/allergies seeds).",
        "item_files": [
          {
            "path": "items/medications.json",
            "sha256": "SHA256_MEDS"
          },
          {
            "path": "items/default_catalog.json",
            "sha256": "SHA256_DEFAULT_CATALOG"
          }
        ]
      },
      "files": {
        "items/medications.json": {
          "metadata": {
            "version": "1.0.0",
            "source": "Health Assistant"
          },
          "items": [
            {
              "name": "Metformin",
              "description": "Oral diabetes medicine.",
              "indications": "Type 2 Diabetes mellitus",
              "side_effects": [
                "Nausea"
              ]
            }
          ]
        },
        "items/default_catalog.json": {
          "metadata": {
            "version": "1.0.0",
            "source": "Health Assistant"
          },
          "units": [
            {
              "symbol": "mg/dL",
              "name": "Milligrams per deciliter",
              "quantity_type": "MASS_CONCENTRATION"
            }
          ],
          "biomarkers": [
            {
              "symbol": "GLU",
              "name": "Glucose",
              "biomarker_class": "metabolic",
              "preferred_unit_symbol": "mg/dL"
            }
          ]
        }
      }
    },
