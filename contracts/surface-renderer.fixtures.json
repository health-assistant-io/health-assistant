    {
      "id": "truncated-notice-and-no-html",
      "purpose": "host-resolved truncation notice renders role=status; the renderer is a closed vocabulary — raw markup from an extension never mounts (D17, every tier)",
      "surface": {
        "nodes": [
          {
            "id": "scanned",
            "type": "stat",
            "bind": "totals.scanned"
          }
        ],
        "values": {
          "totals": {
            "scanned": 5
          }
        },
        "labels": {
          "report.scanned": "Files scanned"
        }
      },
      "truncatedLabel": "12 more runs omitted — rerun to refresh",
      "expect": [
        {
          "kind": "component",
          "type": "stat",
          "id": "scanned",
          "label": "Files scanned",
          "value": "5"
        },
        {
          "kind": "text",
          "text": "12 more runs omitted — rerun to refresh",
          "role": "status"
        },
        {
          "kind": "note",
          "note": "the no-html kind is asserted on every case below (uniform run) — listed once here per the mandate"
        },
        {
          "kind": "no-html"
        }
      ]
    }
  ]
}
