          "kind": "row",
          "rowId": "e2"
        }
      ]
    },
    {
      "id": "unknown-node-degrade",
      "purpose": "an unrecognized node type never renders (closed vocabulary at the render seam, defense-in-depth behind manifest validation) — degrade PROBE (intentionally unknown ids/types, render-level closed-vocabulary law)",
      "surface": {
        "nodes": [
          {
            "id": "ghost",
            "type": "telepathy",
            "bind": "totals.x"
          },
          {
            "id": "kept",
            "type": "stat",
            "bind": "totals.scanned"
          }
        ],
        "values": {
          "totals": {
            "scanned": 7
          }
        },
        "labels": {
          "report.ghost": "Ghosted",
          "report.kept": "Kept"
        }
      },
      "expect": [
        {
          "kind": "component",
          "type": "stat",
          "id": "kept",
          "label": "Kept",
          "value": "7"
        },
        {
          "kind": "absent",
          "testid": "surface-ghost"
        }
      ],
      "degradeProbe": true
