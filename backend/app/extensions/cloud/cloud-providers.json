{
  "schemaVersion": 1,
  "contract": "cloud-providers",
  "updated": "2026-11-03",
  "purpose": "Family cloud-account catalog (ADR-0052). One row per provider: which services it exposes (calendar, files), the transport protocol per service, the verbatim OAuth scope sets for read and write, the hosts token-bearing calls may reach, and the `setupFields` the bind form renders from. Providers are DATA; adapters are CODE keyed by protocol \u2014 adding a provider that speaks an existing protocol costs one row and no code, no UI change. Products never hand-curate provider lists or scope strings \u2014 they render this catalog through their settings surface.",
  "secretDisclosure": "Credentials live only in the host secret store (OS keyring on desktop, keyring/env in server products). No credential value is stored in an account row, a config file, a log line, an export or a model prompt.",
  "authKinds": [
    "oauth2",
    "app-password",
    "token",
    "none"
  ],
  "services": [
    "calendar",
    "files"
  ],
  "protocols": {
    "calendar": [
      "caldav",
      "google-calendar",
      "graph-calendar",
      "ics"
    ],
    "files": [
      "webdav",
      "google-drive",
      "graph-drive",
      "dropbox"
    ]
  },
