{
  "contract": "cloud-connectors",
  "schemaVersion": 1,
  "purpose": "Cross-language acceptance wall for the family cloud calendar/files contract (ADR-0052). The Python checker runs every row; a second-language host (desktop) pins the same rows against its own implementation. Values are data only \u2014 no real credentials, accounts or private events.",
  "catalog": {
    "order": [
      "google",
      "microsoft",
      "nextcloud",
      "icloud",
      "fastmail",
      "caldav",
      "webdav",
      "dropbox",
      "ics"
    ],
    "calendarProviders": [
      "google",
      "microsoft",
      "nextcloud",
      "icloud",
      "fastmail",
      "caldav",
      "ics"
    ],
    "filesProviders": [
      "google",
      "microsoft",
      "nextcloud",
      "fastmail",
      "webdav",
      "dropbox"
    ],
    "scopes": {
      "google": {
        "calendar": {
          "read": [
            "https://www.googleapis.com/auth/calendar.readonly"
          ],
          "write": [
            "https://www.googleapis.com/auth/calendar.readonly",
            "https://www.googleapis.com/auth/calendar.events"
          ]
        },
        "files": {
          "read": [
            "https://www.googleapis.com/auth/drive.readonly"
          ],
          "write": [
            "https://www.googleapis.com/auth/drive.readonly",
            "https://www.googleapis.com/auth/drive.file"
          ]
        }
      },
      "microsoft": {
        "calendar": {
          "read": [
            "Calendars.Read",
            "User.Read",
            "offline_access"
          ],
          "write": [
            "Calendars.ReadWrite",
            "User.Read",
            "offline_access"
          ]
        }
      }
    },
    "scopeGrowth": [
      {
        "granted": [
          "calendar.readonly"
        ],
        "requested": [
          "calendar.readonly",
          "calendar.events"
        ],
        "added": [
          "calendar.events"
        ],
        "removed": []
      },
      {
        "granted": [
          "calendar.readonly",
          "calendar.events"
        ],
        "requested": [
          "calendar.readonly"
        ],
        "added": [],
        "removed": [
          "calendar.events"
        ]
      },
      {
        "granted": [],
        "requested": [
          "a",
          "b"
        ],
        "added": [
          "a",
          "b"
        ],
        "removed": []
      }
    ],
    "setupFields": {
      "requiredKinds": [
        "url",
        "text",
        "secret",
        "calendar"
      ],
      "perProtocol": {
        "caldav": {
          "kinds": [
            "url",
            "calendar",
            "text",
            "secret",
            "secret"
          ],
          "secretAuthKinds": [
            "app-password",
            "token"
          ]
        },
        "google-calendar": {
          "kinds": [
            "calendar"
          ],
          "secretAuthKinds": []
        },
        "graph-calendar": {
          "kinds": [
            "calendar"
          ],
          "secretAuthKinds": []
        },
        "ics": {
          "kinds": [
            "url",
            "secret"
          ],
          "secretAuthKinds": [
            "token"
          ]
        }
      },
      "everyFieldHasLabelKey": true
    },
    "clientIdEnv": {
      "template": "{PREFIX}_{ID}_CLIENT_ID",
      "cases": [
        {
          "id": "google",
          "prefix": "DESKTOP",
          "expect": "DESKTOP_GOOGLE_CLIENT_ID"
        },
        {
          "id": "microsoft",
          "prefix": "DESKTOP",
          "expect": "DESKTOP_MICROSOFT_CLIENT_ID"
        },
        {
          "id": "nextcloud",
          "prefix": "SA",
          "expect": "SA_NEXTCLOUD_CLIENT_ID"
        },
        {
          "id": "google",
          "prefix": "CALENDAR",
          "expect": "CALENDAR_GOOGLE_CLIENT_ID"
        }
      ]
    }
  },
  "ics": {
    "parse": [
      {
        "name": "timed-utc-with-alarm",
        "ics": "BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nUID:evt-1\nDTSTART:20261103T090000Z\nDTEND:20261103T100000Z\nSUMMARY:Midterm exam\\, room 4\nDESCRIPTION:Bring\\nstudent ID\nLOCATION:Building A\nCATEGORIES:EXAM,Study\nSTATUS:TENTATIVE\nTRANSP:TRANSPARENT\nSEQUENCE:2\nBEGIN:VALARM\nACTION:DISPLAY\nTRIGGER:-PT30M\nEND:VALARM\nEND:VEVENT\nEND:VCALENDAR",
        "expect": {
          "uid": "evt-1",
          "summary": "Midterm exam, room 4",
          "description": "Bring\nstudent ID",
          "location": "Building A",
          "allDay": false,
          "start": "2026-11-03T09:00:00Z",
          "end": "2026-11-03T10:00:00Z",
          "status": "tentative",
          "transparency": "transparent",
          "sequence": 2,
          "categories": [
            "EXAM",
            "Study"
          ],
          "alarmsMinutes": [
            30
          ]
        }
      },
      {
        "name": "all-day-bounded-duration",
        "ics": "BEGIN:VCALENDAR\nBEGIN:VEVENT\nUID:evt-2\nDTSTART;VALUE=DATE:20261201\nDURATION:P2D\nSUMMARY:Reading week\nEND:VEVENT\nEND:VCALENDAR",
        "expect": {
          "uid": "evt-2",
          "summary": "Reading week",
          "allDay": true,
          "start": "2026-12-01",
          "end": "2026-12-03",
          "status": "confirmed"
        }
      },
      {
        "name": "tzid-local-time",
        "ics": "BEGIN:VCALENDAR\nBEGIN:VEVENT\nUID:evt-3\nDTSTART;TZID=Europe/Berlin:20261103T140000\nDTEND;TZID=Europe/Berlin:20261103T153000\nSUMMARY:Lecture\nEND:VEVENT\nEND:VCALENDAR",
        "expect": {
          "uid": "evt-3",
          "allDay": false,
          "start": "2026-11-03T13:00:00Z",
          "end": "2026-11-03T14:30:00Z"
        }
      },
      {
